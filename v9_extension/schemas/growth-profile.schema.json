{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eonwild.dev/schemas/growth-profile.schema.json",
  "title": "GrowthProfile",
  "type": "object",
  "required": [
    "schema",
    "id",
    "family",
    "status",
    "continuous_inputs",
    "continuous_traits",
    "regimes",
    "switch_contract",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "eonwild.growth_profile.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "species": {
      "type": [
        "string",
        "null"
      ]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "continuous_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "separation_of_concerns": {
      "type": "object"
    },
    "baseline_scaling": {
      "type": "object"
    },
    "continuous_traits": {
      "type": "object"
    },
    "regimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "motion-regime.schema.json"
      }
    },
    "switch_contract": {
      "type": "object",
      "required": [
        "preserve",
        "forbid"
      ]
    },
    "capability_selection": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "plausible_inference",
            "disputed",
            "speculative",
            "gameplay_only",
            "gameplay_hypothesis",
            "synthetic_test_fixture"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": [
            "object",
            "null"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}