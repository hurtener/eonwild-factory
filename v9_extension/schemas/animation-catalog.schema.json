{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eonwild.dev/schemas/animation-catalog.schema.json",
  "title": "AnimationCatalog",
  "type": "object",
  "required": [
    "schema",
    "catalog_id",
    "species",
    "family",
    "animation_count",
    "animations"
  ],
  "properties": {
    "schema": {
      "const": "eonwild.animation_catalog.v1"
    },
    "catalog_id": {
      "type": "string"
    },
    "species": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "animation_count": {
      "type": "integer",
      "minimum": 1
    },
    "program_count": {
      "type": "integer",
      "minimum": 1
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "animation-spec.schema.json"
      }
    }
  },
  "additionalProperties": true
}