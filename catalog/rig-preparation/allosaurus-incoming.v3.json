  "evidence": [
    {
      "kind": "measured_source_geometry",
      "reference": "ARC/audits/allosaurus-incoming-rig-001/inventory.json",
      "claim": "The two hip origins are bilateral and lie in the proximal thigh surface; their current parent is the anterior axial Bone_002 rather than the measured pelvis Bone_001."
    },
    {
      "kind": "measured_source_geometry",
      "reference": "ARC/audits/allosaurus-rig-landmarks.json",
      "claim": "The welded surface is connected; lower-jaw ownership is instead supported by the existing Bone_044 to Bone_043 to Bone_042 hierarchy and its concentrated lower-head weights."
    },
    {
      "kind": "primary_comparative_measurement",
      "reference": "White et al. 2013, PLOS ONE 8:e68649, Table 2, Allosaurus fragilis UUVP 6000r",
      "claim": "Femur, tibia and metatarsus lengths 880, 730 and 375 mm give 44.33%, 36.77% and 18.90% of their sum; used only as a specimen-specific segment-proportion sanity check along the source chain."
    },
    {
      "kind": "measured_source_geometry",
      "reference": "ARC/audits/allosaurus-jaw-ownership-probe.json",
      "claim": "The declared source-world upper-skull halfspace isolates the dorsal rostrum and upper mouth surface independently of skin weights; the original jaw branch incorrectly moves this region."
    },
    {
      "kind": "measured_source_geometry",
      "reference": "ARC/audits/allosaurus-anatomical-onboarding-001/landmarks.json",
      "claim": "Bilateral hip, knee, ankle and MTP engineering centers are robust centers of declared full-weight surface slabs; pedal landmarks are forward quantiles of the existing shared distal skin family."
    },
    {
      "kind": "engineering_topology",
      "reference": "src/eonwild_motion/solve/airborne_gait.py",
      "claim": "Each non-skinned terminal provides the third node required by the existing generic toe-chain effector contract; it adds no skin influence or digit-anatomy claim."
    },
    {
      "kind": "engineering_topology",
      "reference": "ARC/audits/allosaurus-articulation-gap-001/pedal-seed-probe.json",
      "claim": "Neutral opaque sole inspection resolves three pedal projections per side; the existing central weighted branch is retained and the two added branches are bounded engineering proxies."
    }
  ],
  "limitations": [
    "The source's straight parallel legs and original pivots are deliberate drift-control placeholders, not anatomical measurements.",
    "The fitted surface-slab centers use authored windows and are provisional engineering pivots, not fossil-derived joint centers.",
    "White et al. 2013 UUVP 6000r proportions are a post-fit sanity check only; this artist mesh is not established as that specimen.",
    "The toe chain describes one pedal contact family; its added non-skinned terminal is an effector endpoint, not evidence of a new digit.",
    "The jaw hinge and upper-skull ownership remain the earlier bounded engineering preparation; inner cheek and mouth-corner polish remains unresolved.",
    "The candidate is not admitted to a baseline, motion catalog, Unity project or production asset set.",
    "The three pedal branches are engineering deformation proxies, not a complete fossil phalange reconstruction.",
    "Independent hand digits and mouth-corner soft-tissue ownership remain unresolved."
  ],
