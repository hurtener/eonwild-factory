{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eonwild.motion.run-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "command", "status", "inputs", "outputs", "metrics", "checks", "warnings", "errors", "source", "profile", "toolVersions", "startedAt", "finishedAt"],
  "properties": {
    "schema": {"const": "eonwild.motion.run-report.v1"},
    "runId": {"type": "string", "minLength": 1},
    "command": {"enum": ["build", "validate", "render", "compare", "promote"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/io"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/io"}},
    "metrics": {"type": "object"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitHead", "dirty", "implementer", "engineVersion"],
      "properties": {
        "gitHead": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": ["boolean", "null"]},
        "implementer": {"type": ["string", "null"]},
        "engineVersion": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "lockSha256"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "lockSha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}
      }
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "python", "blender", "gltfValidator"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "blender": {"type": ["string", "null"]},
        "gltfValidator": {"type": ["string", "null"]}
      }
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}
      }
    }
  }
}
