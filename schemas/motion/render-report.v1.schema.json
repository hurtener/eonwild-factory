{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eonwild.motion.render-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "runId", "profile", "source", "artifact", "renderSet", "media", "frame", "clipSemanticId", "camera", "blenderVersion"],
  "properties": {
    "schema": {"const": "eonwild.motion.render-report.v1"},
    "status": {"const": "PASS"},
    "runId": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/profile"},
    "source": {"$ref": "#/$defs/source"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "renderSet": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "media": {"type": "object", "additionalProperties": false, "required": ["path", "fileSha256", "pixelContentSha256", "width", "height", "channels", "canonicalization"], "properties": {"path": {"type": "string"}, "fileSha256": {"$ref": "#/$defs/sha"}, "pixelContentSha256": {"$ref": "#/$defs/sha"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "channels": {"enum": [3, 4]}, "canonicalization": {"const": "decoded-scanlines-filter0-zlib9@1"}}},
    "frame": {"type": "integer", "minimum": 0},
    "clipSemanticId": {"type": "string", "minLength": 1},
    "camera": {"type": "object", "required": ["type", "viewDirection", "margin", "fullBodyBoundsDerived"], "properties": {"fullBodyBoundsDerived": {"const": true}}},
    "blenderVersion": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "sha256", "lockSha256"], "properties": {"id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}, "lockSha256": {"$ref": "#/$defs/sha"}}},
    "source": {"type": "object", "required": ["gitHead"], "properties": {"gitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}}}
  }
}
