{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eonwild.motion.comparison-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "runId", "profile", "source", "baseline", "candidate", "structural", "accessor", "staticFacts", "contactFacts", "media", "review"],
  "properties": {
    "schema": {"const": "eonwild.motion.comparison-report.v1"},
    "status": {"const": "PASS"},
    "runId": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/profile"},
    "source": {"$ref": "#/$defs/source"},
    "baseline": {"$ref": "#/$defs/artifact"},
    "candidate": {"$ref": "#/$defs/artifact"},
    "structural": {"$ref": "#/$defs/passFacts"},
    "accessor": {"$ref": "#/$defs/passFacts"},
    "staticFacts": {"$ref": "#/$defs/passFacts"},
    "contactFacts": {"$ref": "#/$defs/passFacts"},
    "media": {"type": "object", "additionalProperties": false, "required": ["status", "baseline", "candidate", "pixelContentEqual"], "properties": {"status": {"const": "PASS"}, "baseline": {"$ref": "#/$defs/media"}, "candidate": {"$ref": "#/$defs/media"}, "pixelContentEqual": {"type": "boolean"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "browsable", "visualApproval"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}, "browsable": {"const": true}, "visualApproval": {"const": false}}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "sha256", "lockSha256"], "properties": {"id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}, "lockSha256": {"$ref": "#/$defs/sha"}}},
    "source": {"type": "object", "required": ["gitHead"], "properties": {"gitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "media": {"type": "object", "required": ["path", "fileSha256", "pixelContentSha256", "width", "height"], "properties": {"path": {"type": "string"}, "fileSha256": {"$ref": "#/$defs/sha"}, "pixelContentSha256": {"$ref": "#/$defs/sha"}, "width": {"type": "integer"}, "height": {"type": "integer"}}},
    "passFacts": {"type": "object", "required": ["status"], "properties": {"status": {"const": "PASS"}}}
  }
}
